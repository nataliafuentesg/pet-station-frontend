rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FCM tokens: solo el propio usuario puede leer/escribir el suyo
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notificaciones: solo el destinatario puede leerlas
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // solo el backend escribe vía Admin SDK
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
