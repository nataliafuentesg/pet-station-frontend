rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes de mascotas: solo el dueño puede leer/escribir
    match /mascotas/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fórmulas médicas subidas: solo escritura autenticada, sin lectura pública
    match /formulas/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if false; // solo el backend accede vía Admin SDK
    }

    // Bloquear todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
